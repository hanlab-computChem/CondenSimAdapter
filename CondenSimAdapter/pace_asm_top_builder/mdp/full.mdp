
comm-mode           =  Linear
comm-grps           = system
constraints         =  none
integrator          =  md
dt                  =  0.004
nsteps              =  500000000 ; total 200ns .
nstcomm             =  500
nstxout             =  500000
nstvout             =  1000000
nstxtcout           =  25000
;nstxtcout           =  51000
xtc_grps            =  Protein
nstfout             =  0
nstlog              =  40000
nstenergy           =  40000
cutoff-scheme       =  Verlet

ns_type             =  grid
nstlist = 20
coulombtype         =  reaction-field
rcoulomb = 1.1
epsilon_r           =  15
epsilon_rf = 0
vdwtype             =  cut-off
;vdw-modifier = Potential-shift-verlet
vdw-modifier = Force-switch
rvdw-switch = 0.9
rvdw                =  1.1
table-extension     =  1.8
; Berendsen temperature coupling is on in two groups
Tcoupl              =  v-rescale
tc-grps             =  Protein  non-Protein
tau_t               =  1.0   1.0 
;tau_t               =  0.4      0.4
ref_t   =  310.0        310.0
; Energy monitoring
;energygrps          =  Protein  non-Protein
; Pressure coupling is not on
Pcoupl              =  Parrinello-Rahman
tau_p               =  8
;tau_p               =  0.5
compressibility     =  4.5e-5
ref_p               =  1.0
; Generate velocites is on at 300 K.

