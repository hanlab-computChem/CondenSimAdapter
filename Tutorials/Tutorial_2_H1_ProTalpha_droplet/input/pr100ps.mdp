;define = -DPOSRES
integrator = md
dt         = 0.0005  ; ps
nsteps     = 200000 ; 100ps
comm-grps  = system
comm-mode =
energygrps = 
refcoord-scaling = com
;
nstxout = 0
nstvout = 0
nstfout = 0
nstlog  = 500
nstenergy = 500
nstxout-compressed = 1000
compressed-x-grps  = system
;
pbc = xyz
cutoff-scheme            = Verlet
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = Cut-off
rvdw                     = 1.0
DispCorr                 = EnerPres
;
Tcoupl  = V-rescale
tau_t   = 0.5
tc_grps = system
ref_t   = 300
;
Pcoupl     = Berendsen
pcoupltype = isotropic
tau_p = 0.5
ref_p = 1.0
compressibility = 4.5e-5
;
freezegrps  = 
freezedim   = 
constraints = hbonds